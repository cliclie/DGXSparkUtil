[Unit]
Description=DGXSparkUtil Monitor API (FastAPI on port 8080)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__API_DIR__
ExecStartPre=/bin/sh -c 'test -x __API_DIR__/venv/bin/python || (cd __API_DIR__ && python3 -m venv venv && ./venv/bin/pip install -q -r requirements.txt)'
ExecStart=__API_DIR__/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
StandardOutput=append:__API_DIR__/server.log
StandardError=append:__API_DIR__/server.log

[Install]
WantedBy=multi-user.target
