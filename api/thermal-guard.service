[Unit]
Description=GPU thermal guard (GB10 clock cap / R9700 power cap)
After=docker.service systemd-modules-load.service
Wants=docker.service

[Service]
Type=simple
# 特権はこの unit だけに限局する。dgx-spark-api.service は cliclie 権限のまま。
# 実行するコマンドは読み取り (sysfs / nvidia-smi --query / docker ps) と
# nvidia-smi -lgc / -rgc (GB10) もしくは power1_cap 書き込み (R9700) だけ。
# モードは起動時に自動判定する (THERMAL_MODE=clock|power で上書き可)。
ExecStart=__API_DIR__/thermal_guard.sh
# --- clock (GB10) ---------------------------------------------------------------
# 解除しきい値を 85℃ にする (80℃ まで冷やすのを待たない)。
# 実測: 10〜29 秒周期で -lgc を叩いても vLLM は壊れなかった (Xid 0 件 / prefill PASS)。
# 90℃ までフルクロックで走る分、速度は固定ロックより出る。
# 注: THERMAL_GROUPS=1 (2026-11-01 案A) のときこの LOW_C は使わない。CPU 群 / GPU 群
#     それぞれの LOW (既定 82℃ / 78℃) に両方が下回って LOW_SECS (既定 10 秒) 続いて
#     初めて解除する。
Environment=THERMAL_LOW_C=85
# 発動時のロック値。-lgc は指定値を下位の段に丸める (1665 -> 実測 1644MHz)。
# 1500 -> 1475MHz は base 1665MHz の「以下」で、prefill を 2285→1110 T/s (49%) まで
# 落としていた。1644MHz なら acpitz は 90℃ 未満で飽和し、発振なしに速度が上がる見込み。
Environment=THERMAL_LOCK_HIGH_MHZ=1665
# --- power (R9700 / atom2) ------------------------------------------------------
# GPU 温度 (junction) のみを見る 3 段電力上限。85℃ 以下は最大 300W、85℃ 超 250W、
# 95℃ 超 210W (sysfs power1_cap_min = 210W が書ける下限)。ロード中の LLM は問わない。
# 2026-11-12 Phase 1a+1b。対照実測 (hipfire 12,967 tok prefill 連続投入 240 秒 /
# 開始 junction 40〜41℃ 統一):
#   旧 80/90 + 単一閾値 + release 2s : 段切り替え 64 回 / cap平均 236.5W / 210W 滞留 93s
#                                        junction 平均 87.1℃ 最大 97℃
#   新 85/95 + hyst 4℃ + release 10s: 段切り替え  1 回 / cap平均 253.4W / 210W 滞留  0s
#                                        junction 平均 89.6℃ 最大 95℃
#   -> 発振 -98%、実効電力 +7.1%、ピーク温度は逆に 2℃ 下がる。
# 安全性: junction crit=110℃ emerg=115℃、mem crit=108℃。95℃ 段でも余裕 15℃ あり、
# GPU 側 PMFW のファンカーブ (実測 3400rpm / max 5500) が独立に効き続ける。
Environment=THERMAL_POWER_HIGH_C=85
Environment=THERMAL_POWER_CRIT_C=95
Environment=THERMAL_CAP_HIGH_W=250
Environment=THERMAL_CAP_CRIT_W=210
Environment=THERMAL_CAP_MAX_W=300
# 解除側ヒステリシス (既定は発動閾値 - THERMAL_POWER_HYST_C)。250W は 81℃ を、
# 210W は 91℃ を割ってから 300/250W へ戻る。THERMAL_POWER_HYST_C=0 にすると
# 発動=解除の単一閾値 (従来の挙動) に戻る。個別上書きは HIGH_LOW_C / CRIT_LOW_C。
Environment=THERMAL_POWER_HYST_C=4
# 電力制限の解放 (電力を上げる) は、その狙い値が RELEASE_SECS 秒以上続いてから適用。
# 下げる方向は即時。2 秒だと解放直後の +40W で 1 秒 / +7℃ スパイクして即再発動し、
# 3〜4 秒周期 (250W 段) 〜14 秒周期 (210W 段) の発振になった (実測 64 回/240 秒)。
Environment=THERMAL_POWER_RELEASE_SECS=10
Restart=always
RestartSec=5
# /run/thermal を自動作成 (unit 停止時に自動削除)。state は 0644 で書かれ
# cliclie の dgx-spark-api.service が /api/thermal で読む。
RuntimeDirectory=thermal
RuntimeDirectoryMode=0755
# 温度監視なので CPU 優先度を落とさない (nice すると prefill 中に後回しにされる)
Nice=0
# atom2: amdgpu モジュールロード完了 (power1_cap sysfs 出現) を最大 120 秒待つ
# (実装メモ 2026-10-03 の llm-gpu-powercap.service と同じ教訓)。
# GB10 は nvidia-smi が PATH にあれば即通過する。
ExecStartPre=/bin/sh -c 'for i in $(seq 1 120); do command -v nvidia-smi >/dev/null 2>&1 && exit 0; ls /sys/class/drm/card*/device/hwmon/hwmon*/power1_cap >/dev/null 2>&1 && exit 0; sleep 1; done; echo "neither nvidia-smi nor amdgpu power1_cap appeared after 120s" >&2; exit 1'

[Install]
WantedBy=multi-user.target
